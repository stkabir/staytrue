<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import * as THREE from 'three';

  gsap.registerPlugin(ScrollTrigger);
  gsap.defaults({ ease: 'power3.out', overwrite: 'auto' });
  ScrollTrigger.config({ ignoreMobileResize: true });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Lenis smooth scroll, driven by the GSAP ticker ─────────
  // One RAF loop for scroll + animation = no competing loops, no jank.
  let lenis: Lenis | null = null;
  if (!reduceMotion) {
    lenis = new Lenis({
      duration: 1.05,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      touchMultiplier: 1.6,
    });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis!.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  // ── Split section-header h2 into word spans (preserves <br/>) ─
  document.querySelectorAll<HTMLElement>('.section-header h2').forEach(h => {
    // Gradient must be re-applied per word, not left on the parent: once GSAP
    // puts a `transform` on each split-word span, Chrome's background-clip:text
    // on the multi-word ancestor mis-clips and words render stacked on top of
    // each other. Clipping per (already-transformed) leaf span avoids it.
    const gradient = h.classList.contains('grad-heading');
    if (gradient) h.classList.remove('grad-heading');
    Array.from(h.childNodes).forEach(node => {
      if (node.nodeType !== Node.TEXT_NODE || !node.textContent) return;
      const frag = document.createDocumentFragment();
      node.textContent.split(/(\s+)/).forEach(part => {
        if (!part) return;
        if (/^\s+$/.test(part)) {
          frag.appendChild(document.createTextNode(part));
        } else {
          const span = document.createElement('span');
          span.className = gradient ? 'split-word grad-heading' : 'split-word';
          span.textContent = part;
          frag.appendChild(span);
        }
      });
      node.parentNode!.replaceChild(frag, node);
    });
  });

  // ── Refresh after fonts/images settle ─────────────────────
  window.addEventListener('load', () => ScrollTrigger.refresh());

  // ── Scroll progress bar ────────────────────────────────────
  gsap.to('#scroll-progress', {
    scaleX: 1, ease: 'none',
    scrollTrigger: { start: 'top top', end: 'max', scrub: true },
  });

  // ── Navbar scrolled state (CSS class toggle) ─────────────
  ScrollTrigger.create({
    start: 'top -1',
    onUpdate: (self) => {
      const navbar = document.getElementById('navbar');
      if (navbar) navbar.classList.toggle('navbar-scrolled', self.progress > 0);
    },
  });

  const mm = gsap.matchMedia();

  // ═══════════════ HERO ENTRANCE + COUNTERS ═══════════════
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const heroTl = gsap.timeline({ delay: 0.15 });

    heroTl.from('.hero-location-badge', { opacity: 0, y: 16, duration: 0.5 });

    heroTl.from('#hero-headline span', {
      clipPath: 'inset(0 100% 0 0)',
      opacity: 0, y: 40, rotateX: -25,
      transformPerspective: 900, transformOrigin: 'left center',
      duration: 0.8, stagger: 0.2, ease: 'expo.out',
    }, 0.1);

    heroTl.from('.hero-description', { opacity: 0, y: 30, duration: 0.6 }, 0.55);
    heroTl.from('.hero-ctas > *',     { opacity: 0, y: 20, duration: 0.5, stagger: 0.1 }, 0.7);
    heroTl.from('.hero-parallax-visual', {
      opacity: 0, x: 72, rotateY: 12, transformPerspective: 1400,
      duration: 1.15, ease: 'expo.out',
    }, 0.2);
    heroTl.from('.hero-stats', { opacity: 0, y: 16, duration: 0.5 }, 0.8);

    // Scroll cue: looping hint that fades out once you actually scroll
    gsap.to('#scroll-cue-fill', {
      yPercent: 200, duration: 1.6, ease: 'power2.inOut', repeat: -1,
    });
    gsap.to('#scroll-cue', {
      opacity: 0, ease: 'none',
      scrollTrigger: { trigger: '#hero', start: 'top top', end: '+=260', scrub: true },
    });

    // Counters (hero stats + metrics band)
    const runCounter = (el: HTMLElement, target: number, prefix: string) => {
      el.textContent = prefix + '0';
      const obj = { val: 0 };
      const count = () => gsap.to(obj, {
        val: target, duration: 1.8, ease: 'power2.out',
        onUpdate: () => { el.textContent = prefix + Math.round(obj.val); },
      });
      // Already on screen at load (hero stats): run now. A ScrollTrigger would
      // sit at "0" until the first scroll, which reads as a broken number.
      if (el.getBoundingClientRect().top < window.innerHeight) {
        gsap.delayedCall(0.9, count);
        return;
      }
      ScrollTrigger.create({ trigger: el, start: 'top 90%', once: true, onEnter: count });
    };
    document.querySelectorAll<HTMLElement>('[data-counter]').forEach(el =>
      runCounter(el, parseInt(el.dataset.counter || '0', 10), el.dataset.prefix || '')
    );
    document.querySelectorAll<HTMLElement>('[data-metric]').forEach(el =>
      runCounter(el, parseInt(el.dataset.metric || '0', 10), '')
    );
  });

  // ═══════════════ FLUID REVEALS ═══════════════
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const desktop = window.innerWidth >= 768;

    if (desktop) {
      gsap.to('.hero-parallax-text', {
        y: -70, opacity: 0.4, ease: 'none',
        scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 0.6 },
      });
      gsap.to('.hero-parallax-visual', {
        y: -110, rotateY: -4, ease: 'none',
        scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 0.6 },
      });
    }

    // ── Section headers: meta + word-by-word reveal ────────────
    gsap.utils.toArray<HTMLElement>('.section-header').forEach(header => {
      const words = header.querySelectorAll('h2 .split-word');
      const meta  = Array.from(header.children).filter(c => c.tagName !== 'H2');
      const tl = gsap.timeline({
        scrollTrigger: { trigger: header, start: 'top 85%', once: true },
      });
      tl.from(meta, { opacity: 0, y: 22, duration: 0.5, stagger: 0.07 });
      if (words.length) {
        tl.from(words, {
          opacity: 0, y: 26, rotateX: desktop ? -35 : 0, transformPerspective: 800,
          duration: 0.6, stagger: 0.035, ease: 'expo.out',
        }, 0.15);
      }
    });

    // ── Batched card reveal helper (one observer per group) ────
    const reveal = (selector: string, from: gsap.TweenVars, stagger = 0.09) => {
      const els = gsap.utils.toArray<HTMLElement>(selector);
      if (!els.length) return;
      gsap.set(els, from);
      ScrollTrigger.batch(els, {
        start: 'top 88%', once: true,
        onEnter: (batch) => gsap.to(batch, {
          opacity: 1, x: 0, y: 0, scale: 1, rotateX: 0, rotateY: 0,
          duration: 0.7, ease: 'power3.out', stagger, overwrite: true,
          onComplete: () => batch.forEach(el => { (el as HTMLElement).style.willChange = 'auto'; }),
        }),
      });
    };

    reveal('#servicios .card-spotlight',                 { opacity: 0, y: 56, rotateX: desktop ? -12 : 0, transformPerspective: 1000 });
    reveal('#proyectos .grid-card',                      { opacity: 0, y: 44, scale: 0.97 }, 0.06);
    reveal('#nosotros .card-spotlight:not(#bento-main)', { opacity: 0, y: 44, rotateY: desktop ? 5 : 0 });
    reveal('#bento-main',                                { opacity: 0, y: 40, scale: 0.94 });
    reveal('#stack .grid > div',                         { opacity: 0, y: 28, scale: 0.9 }, 0.05);
    reveal('.metric-item',                               { opacity: 0, y: 32 }, 0.08);
    reveal('.faq-row',                                   { opacity: 0, y: 24 }, 0.06);

    // ── Proceso: reveal + sequential active glow ───────────────
    gsap.utils.toArray<HTMLElement>('.process-step').forEach((step, i) => {
      gsap.set(step, { opacity: 0, y: 40, scale: 0.97 });
      ScrollTrigger.create({
        trigger: step, start: 'top 85%', once: true,
        onEnter: () => {
          gsap.to(step, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: 'power3.out', delay: i * 0.05 });
          gsap.to(step, {
            borderColor: 'rgba(34,197,94,0.3)',
            boxShadow: '0 0 0 1px rgba(34,197,94,0.12), 0 4px 32px rgba(0,0,0,0.32), 0 0 32px rgba(34,197,94,0.1)',
            duration: 0.5, delay: 0.3 + i * 0.05,
          });
          const num = step.querySelector<HTMLElement>('.step-number');
          if (num) gsap.to(num, { color: 'rgba(34,197,94,0.4)', duration: 0.5, delay: 0.3 + i * 0.05 });
        },
      });
    });

    reveal('#contacto .relative.max-w-4xl', { opacity: 0, y: 48, scale: 0.96 });
  });

  // ═══════════════ SIGNATURE: PINNED HORIZONTAL CINEMA ═══════════════
  // Desktop only. Touch devices keep native swipe-snap (see global.css) —
  // pinning a horizontal track on touch fights the user's own gesture.
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const track  = document.getElementById('cinema-track');
    const cinema = document.getElementById('cinema');
    const bar    = document.getElementById('cinema-bar');
    const label  = document.getElementById('cinema-index');
    if (!track || !cinema) return;

    const panels = gsap.utils.toArray<HTMLElement>('.cinema-panel');
    // Recomputed on every refresh so resizes/zoom don't strand the track.
    const distance = () => Math.max(0, track.scrollWidth - window.innerWidth + 96);

    const tween = gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: cinema,
        start: 'top top',
        end: () => '+=' + distance(),
        pin: true,
        scrub: 0.8,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          if (bar) gsap.set(bar, { scaleX: self.progress });
          if (label) {
            const i = Math.min(panels.length, Math.round(self.progress * (panels.length - 1)) + 1);
            label.textContent = String(i).padStart(2, '0');
          }
        },
      },
    });

    // Panels drift in depth as they cross the middle of the screen —
    // the "journey" beat: each project arrives, peaks, recedes.
    panels.forEach(panel => {
      gsap.fromTo(panel,
        { scale: 0.9, opacity: 0.45 },
        {
          scale: 1, opacity: 1, ease: 'none',
          scrollTrigger: {
            trigger: panel,
            containerAnimation: tween,
            start: 'left 88%',
            end: 'center 52%',
            scrub: true,
          },
        }
      );
    });

    return () => { tween.scrollTrigger?.kill(); tween.kill(); };
  });

  // Reduced-motion / no-JS-animation path still needs the panels visible.
  mm.add('(prefers-reduced-motion: reduce)', () => {
    gsap.set('.cinema-panel', { opacity: 1, scale: 1 });
  });

  // ── Mobile menu ────────────────────────────────────────────
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen   = document.getElementById('icon-open');
  const iconClose  = document.getElementById('icon-close');

  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    menuToggle?.setAttribute('aria-expanded', String(open));
  };
  menuToggle?.addEventListener('click', () =>
    setMenu(mobileMenu?.classList.contains('hidden') ?? false)
  );
  document.querySelectorAll('.mobile-nav-link').forEach(link =>
    link.addEventListener('click', () => setMenu(false))
  );

  // ── Card spotlight ─────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.card-spotlight').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    });
  });

  // ── FAQ: keep only one answer open at a time ───────────────
  const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
  faqItems.forEach(item => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;
      faqItems.forEach(other => { if (other !== item) other.open = false; });
      ScrollTrigger.refresh();
    });
  });

  // ── Anchor scroll (Lenis-aware) ────────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector<HTMLElement>(href);
      if (!target) return;
      e.preventDefault();
      if (lenis) lenis.scrollTo(target, { offset: -72, duration: 1.1 });
      else target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // ── Magnetic button effect on CTA buttons ───────────────────
  document.querySelectorAll<HTMLElement>('.magnetic-btn').forEach(btn => {
    btn.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = btn.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      gsap.to(btn, { x: x * 0.35, y: y * 0.35, duration: 0.3, ease: 'power2.out' });
    });
    btn.addEventListener('mouseleave', () => {
      gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
    });
  });

  // ── Hero particle network (Three.js) ──────────────────────
  if (!reduceMotion) {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (canvas) {
      const W = () => window.innerWidth;
      const H = () => window.innerHeight;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setClearColor(0x000000, 0);
      renderer.setSize(W(), H(), false);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(65, W() / H(), 0.1, 50);
      camera.position.z = 5.5;

      const COUNT = W() < 768 ? 55 : 130;
      const posArr = new Float32Array(COUNT * 3);
      const pData: { x: number; y: number; z: number; vx: number; vy: number; vz: number }[] = [];

      for (let i = 0; i < COUNT; i++) {
        const x = (Math.random() - 0.5) * 18;
        const y = (Math.random() - 0.5) * 12;
        const z = (Math.random() - 0.5) * 6;
        posArr[i * 3] = x; posArr[i * 3 + 1] = y; posArr[i * 3 + 2] = z;
        pData.push({ x, y, z,
          vx: (Math.random() - 0.5) * 0.007,
          vy: (Math.random() - 0.5) * 0.005,
          vz: (Math.random() - 0.5) * 0.003,
        });
      }

      const pointGeo = new THREE.BufferGeometry();
      const posAttr = new THREE.BufferAttribute(posArr, 3);
      pointGeo.setAttribute('position', posAttr);
      scene.add(new THREE.Points(pointGeo,
        new THREE.PointsMaterial({ color: 0x22c55e, size: 0.06, transparent: true, opacity: 0.85, sizeAttenuation: true })
      ));

      const MAX_LINES = 250;
      const lineArr = new Float32Array(MAX_LINES * 6);
      const lineGeo = new THREE.BufferGeometry();
      const lineAttr = new THREE.BufferAttribute(lineArr, 3);
      lineGeo.setAttribute('position', lineAttr);
      lineGeo.setDrawRange(0, 0);
      scene.add(new THREE.LineSegments(lineGeo,
        new THREE.LineBasicMaterial({ color: 0x22c55e, transparent: true, opacity: 0.14 })
      ));

      let mx = 0, my = 0;
      window.addEventListener('mousemove', (e: MouseEvent) => {
        mx = (e.clientX / W() - 0.5) * 2;
        my = -(e.clientY / H() - 0.5) * 2;
      });

      window.addEventListener('resize', () => {
        renderer.setSize(W(), H(), false);
        camera.aspect = W() / H();
        camera.updateProjectionMatrix();
      });

      const THRESHOLD_SQ = 3.4 * 3.4;
      const docH = () => document.documentElement.scrollHeight - H();

      // ── Only render while hero is on-screen and tab is visible ─
      // (particle sim + line rebuild is the heaviest per-frame cost;
      //  pausing it once scrolled past frees the main thread for scroll)
      let heroVisible = true;
      let running = true;
      const syncRunning = () => { running = heroVisible && !document.hidden; };
      new IntersectionObserver(([entry]) => {
        heroVisible = entry.isIntersecting;
        syncRunning();
      }, { threshold: 0 }).observe(canvas);
      document.addEventListener('visibilitychange', syncRunning);

      ;(function tick() {
        requestAnimationFrame(tick);
        if (!running) return;

        for (let i = 0; i < COUNT; i++) {
          const d = pData[i];
          d.x += d.vx; d.y += d.vy; d.z += d.vz;
          if (Math.abs(d.x) > 9)   d.vx *= -1;
          if (Math.abs(d.y) > 6)   d.vy *= -1;
          if (Math.abs(d.z) > 3)   d.vz *= -1;
          posArr[i * 3] = d.x; posArr[i * 3 + 1] = d.y; posArr[i * 3 + 2] = d.z;
        }
        posAttr.needsUpdate = true;

        let lc = 0;
        outer: for (let i = 0; i < COUNT; i++) {
          for (let j = i + 1; j < COUNT; j++) {
            if (lc >= MAX_LINES) break outer;
            const dx = pData[i].x - pData[j].x;
            const dy = pData[i].y - pData[j].y;
            const dz = pData[i].z - pData[j].z;
            if (dx * dx + dy * dy + dz * dz < THRESHOLD_SQ) {
              const o = lc * 6;
              lineArr[o]     = pData[i].x; lineArr[o + 1] = pData[i].y; lineArr[o + 2] = pData[i].z;
              lineArr[o + 3] = pData[j].x; lineArr[o + 4] = pData[j].y; lineArr[o + 5] = pData[j].z;
              lc++;
            }
          }
        }
        lineGeo.setDrawRange(0, lc * 2);
        lineAttr.needsUpdate = true;

        camera.position.x += (mx * 0.7 - camera.position.x) * 0.045;
        camera.position.y += (my * 0.45 - camera.position.y) * 0.045;
        camera.position.z = 5.5 - (window.scrollY / Math.max(docH(), 1)) * 2.8;

        renderer.render(scene, camera);
      })();
    }
  }
</script>
</html>
