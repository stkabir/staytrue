<body class="bg-canvas text-fg font-sans antialiased overflow-x-hidden">

  <div id="scroll-progress"></div>

  <a href="#hero" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-white">
    Saltar al contenido
  </a>

  <!-- ══════════════════════════════════════
       LAYERED BACKGROUND SYSTEM
  ══════════════════════════════════════ -->
  <div class="fixed inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0"
      style="background: radial-gradient(ellipse at top center, #0b1e0e 0%, #030704 50%, #010402 100%);">
    </div>
    <div class="absolute inset-0 opacity-[0.018]"
      style="background-image: radial-gradient(rgba(255,255,255,0.55) 1px, transparent 1px);
             background-size: 32px 32px;">
    </div>
    <div class="absolute -top-48 left-1/2 -translate-x-1/2 w-[1000px] h-[700px] rounded-full"
      style="background: radial-gradient(ellipse, rgba(34,197,94,0.13) 0%, transparent 70%); filter: blur(90px);">
    </div>
    <div class="absolute top-1/3 -left-48 w-[600px] h-[500px] rounded-full"
      style="background: radial-gradient(ellipse, rgba(16,185,129,0.08) 0%, transparent 70%); filter: blur(110px);">
    </div>
    <div class="absolute top-1/2 -right-48 w-[550px] h-[650px] rounded-full"
      style="background: radial-gradient(ellipse, rgba(132,204,22,0.06) 0%, transparent 70%); filter: blur(120px);">
    </div>
  </div>

  <!-- ══════════════════════════════════════
       NAVBAR
  ══════════════════════════════════════ -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 border-b border-white/[0.06]">
    <div class="absolute inset-0 bg-canvas/80 backdrop-blur-xl"></div>
    <div class="relative max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">

      <a href="/" class="flex items-center gap-3" aria-label="Stay True — inicio">
        <img src="/img/logo.svg" alt="Stay True logo" class="h-8 w-8" width="32" height="32" />
      </a>

      <div class="hidden md:flex items-center gap-8">
        {navItems.map(([label, id]) => (
          <a href={`#${id}`} class="text-sm text-fg-muted hover:text-fg transition-colors duration-200">
            {label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <!-- Kept visible on mobile too: a portfolio site's whole job is
             getting the visitor to start a conversation. -->
        <a href="#contacto"
          class="magnetic-btn inline-flex items-center gap-1.5 px-3.5 md:px-4 py-2 rounded-lg text-xs md:text-sm font-medium text-white bg-accent hover:bg-accent-bright transition-all duration-200 active:scale-[0.97]"
          style="box-shadow: 0 0 0 1px rgba(34,197,94,0.5), 0 4px 16px rgba(34,197,94,0.28), inset 0 1px 0 rgba(255,255,255,0.14);">
          Hablemos
          <svg class="hidden md:block" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <button id="menu-toggle" class="md:hidden p-2 text-fg-muted hover:text-fg transition-colors"
          aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden relative border-t border-white/[0.06]">
      <div class="absolute inset-0 bg-canvas/95 backdrop-blur-xl"></div>
      <div class="relative px-6 py-6 flex flex-col gap-1">
        {navItems.map(([label, id]) => (
          <a href={`#${id}`}
            class="mobile-nav-link py-3 text-fg-muted hover:text-fg transition-colors border-b border-white/[0.04] last:border-0">
            {label}
          </a>
        ))}
        <a href="#contacto"
          class="mobile-nav-link mt-4 w-full text-center px-4 py-3 rounded-lg text-sm font-medium text-white bg-accent"
          style="box-shadow: 0 0 0 1px rgba(34,197,94,0.4), 0 4px 14px rgba(34,197,94,0.25);">
          Hablemos
        </a>
      </div>
    </div>
  </nav>

  <main>

  <!-- ══════════════════════════════════════
       1 · HOOK — HERO
  ══════════════════════════════════════ -->
  <section id="hero" class="relative min-h-screen flex items-center pt-16">
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
    <div class="relative max-w-7xl mx-auto px-6 py-24 lg:py-32 w-full">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div class="space-y-8 hero-parallax-text">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/25 bg-accent/[0.07] text-accent text-xs font-mono tracking-widest uppercase hero-location-badge">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse-glow inline-block"></span>
            Xalapa · Cancún · Todo México
          </div>

          <h1 id="hero-headline" class="text-5xl md:text-6xl lg:text-[4.5rem] font-semibold tracking-tight leading-[1.04]">
            <span class="block grad-heading">Construimos</span>
            <span class="block shimmer-text">software</span>
            <span class="block grad-heading">que perdura.</span>
          </h1>

          <p class="text-lg md:text-xl text-fg-muted leading-relaxed max-w-lg hero-description">
            Estudio de desarrollo digital mexicano con más de 7 años de experiencia y bases
            en Xalapa, Veracruz y Cancún, Quintana Roo. Aplicaciones web, apps móviles y software
            de escritorio a medida — construidos para rendir y escalar, en todo México.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 hero-ctas">
            <a href="#contacto"
              class="magnetic-btn inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg text-sm font-medium text-white bg-accent hover:bg-accent-bright transition-all duration-200 active:scale-[0.97]"
              style="box-shadow: 0 0 0 1px rgba(34,197,94,0.5), 0 6px 28px rgba(34,197,94,0.3), inset 0 1px 0 rgba(255,255,255,0.14);">
              Iniciar un proyecto
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
            <a href="#proyectos"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg text-sm font-medium text-fg transition-all duration-200 hover:bg-white/[0.05]"
              style="box-shadow: inset 0 0 0 1px rgba(255,255,255,0.09);">
              Ver proyectos
            </a>
          </div>

          <div class="flex gap-8 pt-4 border-t border-white/[0.07] hero-stats">
            {[
              { val: "+7",   label: "Años de experiencia", counter: 7  },
              { val: "+12",  label: "Proyectos entregados", counter: 12 },
              { val: "MX",   label: "Empresa mexicana" },
            ].map(s => (
              <div>
                <div class="text-2xl font-semibold text-fg"
                     data-counter={s.counter ?? undefined}
                     data-prefix={s.counter ? '+' : undefined}>{s.val}</div>
                <div class="text-xs text-fg-muted mt-1">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Hero visual -->
        <div class="relative hidden lg:flex items-center justify-center h-[520px] hero-parallax-visual">
          <div class="absolute w-72 rounded-2xl overflow-hidden animate-float"
            style="background: linear-gradient(135deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.025) 100%);
                   border: 1px solid rgba(255,255,255,0.09);
                   box-shadow: 0 0 0 1px rgba(255,255,255,0.05), 0 24px 64px rgba(0,0,0,0.55), 0 0 80px rgba(34,197,94,0.07);">
            <div class="px-4 py-3 border-b border-white/[0.06] flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-red-400/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-400/60"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-accent/60"></div>
              <span class="ml-3 text-[10px] text-fg-muted font-mono">ProjectController.php</span>
            </div>
            <div class="p-5 font-mono text-[11px] leading-[1.7]">
              <div><span class="text-fg-muted">{"// API REST · Laravel 11"}</span></div>
              <div class="mt-1"><span class="text-accent-lime">class</span>&nbsp;<span class="text-accent-bright">ProjectController</span></div>
              <div><span class="text-fg/40">&#123;</span></div>
              <div class="pl-4"><span class="text-accent-lime">public function</span>&nbsp;<span class="text-accent">index</span><span class="text-fg/40">()</span></div>
              <div class="pl-4"><span class="text-fg/40">&#123;</span></div>
              <div class="pl-8"><span class="text-accent-lime">return</span>&nbsp;<span class="text-accent-mint">response</span><span class="text-fg/40">()-&gt;</span><span class="text-accent">json</span><span class="text-fg/40">(</span></div>
              <div class="pl-12"><span class="text-accent">Project</span><span class="text-fg/40">::</span><span class="text-accent-mint">all</span><span class="text-fg/40">()</span></div>
              <div class="pl-8"><span class="text-fg/40">);</span></div>
              <div class="pl-4"><span class="text-fg/40">&#125;</span></div>
              <div><span class="text-fg/40">&#125;</span></div>
            </div>
          </div>

          <div class="absolute top-10 right-8 px-3 py-2.5 rounded-xl animate-float-slow"
            style="background: rgba(5,12,7,0.9); border: 1px solid rgba(34,197,94,0.25); box-shadow: 0 8px 32px rgba(0,0,0,0.5);">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                style="background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.25);">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="#22c55e" stroke-width="2"><circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </div>
              <div>
                <div class="text-[10px] font-medium text-fg">Web App</div>
                <div class="text-[9px] text-fg-muted">Astro.js / React</div>
              </div>
            </div>
          </div>

          <div class="absolute bottom-20 left-4 px-3 py-2.5 rounded-xl animate-float"
            style="background: rgba(5,12,7,0.9); border: 1px solid rgba(16,185,129,0.25); box-shadow: 0 8px 32px rgba(0,0,0,0.5); animation-delay: -4s;">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                style="background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.25);">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="#10b981" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                  <line x1="12" y1="18" x2="12.01" y2="18"/>
                </svg>
              </div>
              <div>
                <div class="text-[10px] font-medium text-fg">App Móvil</div>
                <div class="text-[9px] text-fg-muted">React Native</div>
              </div>
            </div>
          </div>

          <div class="absolute top-28 left-2 px-3 py-2.5 rounded-xl animate-float-slower"
            style="background: rgba(5,12,7,0.9); border: 1px solid rgba(132,204,22,0.25); box-shadow: 0 8px 32px rgba(0,0,0,0.5);">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                style="background: rgba(132,204,22,0.15); border: 1px solid rgba(132,204,22,0.25);">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="#84cc16" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
              </div>
              <div>
                <div class="text-[10px] font-medium text-fg">Escritorio</div>
                <div class="text-[9px] text-fg-muted">Tauri / Electron</div>
              </div>
            </div>
          </div>

          <div class="absolute bottom-6 right-2 px-4 py-3 rounded-xl animate-float-slow"
            style="background: rgba(5,12,7,0.9); border: 1px solid rgba(255,255,255,0.09); box-shadow: 0 8px 32px rgba(0,0,0,0.5); animation-delay: -6s;">
            <div class="text-[9px] font-mono text-fg-muted tracking-widest uppercase mb-2">Rendimiento</div>
            <div class="flex items-end gap-1 mb-2">
              <span class="text-2xl font-semibold text-accent leading-none">99</span>
              <span class="text-fg-muted text-xs pb-0.5">/ 100</span>
            </div>
            <div class="h-1.5 w-24 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.07);">
              <div class="h-full w-[99%] rounded-full"
                style="background: linear-gradient(90deg, #10b981, #22c55e, #84cc16);">
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Scroll cue -->
    <div id="scroll-cue" class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-2 pointer-events-none">
      <span class="text-[10px] font-mono tracking-[0.2em] uppercase text-fg-muted">Scroll</span>
      <span class="block w-px h-10 overflow-hidden" style="background: rgba(255,255,255,0.12);">
        <span id="scroll-cue-fill" class="block w-full h-1/2 bg-accent"></span>
      </span>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       2 · TRUST — QUIÉN YA CONFIÓ
  ══════════════════════════════════════ -->
  <section class="relative py-12 border-y border-white/[0.06] bg-canvas-deep/40">
    <p class="text-center text-[10px] font-mono tracking-[0.25em] uppercase text-fg-muted mb-8 px-6">
      Software entregado para
    </p>
    <div class="marquee relative overflow-hidden">
      <div class="marquee-track" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="flex items-center shrink-0">
            {clients.map(name => (
              <span class="px-8 text-lg md:text-xl font-medium text-fg-muted/70 whitespace-nowrap">
                {name}
                <span class="ml-8 text-accent/30">◆</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <p class="sr-only">Clientes: {clients.join(", ")}.</p>
  </section>

  <!-- ══════════════════════════════════════
       3 · CONTEXT — SERVICIOS
  ══════════════════════════════════════ -->
  <section id="servicios" class="relative py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6">

      <div class="max-w-2xl mb-16 section-header">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/25 bg-accent/[0.07] text-accent text-xs font-mono tracking-widest uppercase mb-6">
          Qué hacemos
        </div>
        <h2 class="text-4xl md:text-5xl font-semibold tracking-tight leading-tight mb-5 grad-heading">
          Toda plataforma.<br/>Un solo estudio.
        </h2>
        <p class="text-lg text-fg-muted leading-relaxed">
          Desarrollamos productos digitales en todas las plataformas principales — entregando
          calidad consistente y experiencias excepcionales donde estén tus usuarios.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        {services.map(svc => (
          <div
            class="group card-spotlight rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1"
            style="background: linear-gradient(135deg, rgba(255,255,255,0.055) 0%, rgba(255,255,255,0.018) 100%);
                   border: 1px solid rgba(255,255,255,0.07);
                   box-shadow: 0 0 0 1px rgba(255,255,255,0.035), 0 4px 28px rgba(0,0,0,0.32);"
          >
            <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
              style={`background: linear-gradient(135deg, ${svc.hoverGrad} 0%, transparent 55%);`}>
            </div>
            <div class="w-12 h-12 rounded-xl mb-6 flex items-center justify-center"
              style={`background: ${svc.iconBg}; border: 1px solid ${svc.iconBorder};`}
              set:html={svc.icon}>
            </div>
            <h3 class="text-xl font-semibold text-fg mb-3 tracking-tight">{svc.title}</h3>
            <p class="text-sm text-fg-muted leading-relaxed mb-6">{svc.description}</p>
            <div class="flex flex-wrap gap-2">
              {svc.tags.map(tag => (
                <span class="px-2 py-1 rounded-md text-[11px] font-mono"
                  style={`color: ${svc.tagColor.text}; border: 1px solid ${svc.tagColor.border}; background: ${svc.tagColor.bg};`}>
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       4 · JOURNEY — CINEMA DE PROYECTOS
       Signature moment: pinned horizontal scroll (lg+),
       native swipe-snap on touch.
  ══════════════════════════════════════ -->
  <section id="proyectos" class="relative">

    <div class="max-w-7xl mx-auto px-6 pt-24 lg:pt-32 pb-12">
      <div class="max-w-2xl section-header">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/25 bg-accent/[0.07] text-accent text-xs font-mono tracking-widest uppercase mb-6">
          Proyectos reales
        </div>
        <h2 class="text-4xl md:text-5xl font-semibold tracking-tight leading-tight mb-5 grad-heading">
          Trabajo entregado<br/>en producción.
        </h2>
        <p class="text-lg text-fg-muted leading-relaxed">
          Cada captura es el sitio real, en vivo, hoy. Desde sistemas de gobierno hasta
          marketplaces y resorts de lujo — proyectos que siguen corriendo y generando valor.
        </p>
      </div>
    </div>

    <div id="cinema" class="relative lg:h-screen lg:flex lg:flex-col lg:justify-center overflow-hidden pb-8 lg:pb-0 lg:pt-16">

      <!-- Desktop progress rail -->
      <div class="hidden lg:block max-w-7xl mx-auto px-6 w-full mb-8">
        <div class="flex items-center gap-4">
          <span id="cinema-index" class="text-xs font-mono text-accent tabular-nums">01</span>
          <div class="flex-1 h-px" style="background: rgba(255,255,255,0.09);">
            <div id="cinema-bar" class="h-px bg-accent origin-left" style="transform: scaleX(0); width: 100%;"></div>
          </div>
          <span class="text-xs font-mono text-fg-muted tabular-nums">{String(featured.length).padStart(2, '0')}</span>
        </div>
      </div>

      <div id="cinema-track" class="cinema-viewport lg:max-w-none">
        {featured.map((p, i) => (
          <article class="cinema-panel group">
            <a href={p.url} target="_blank" rel="noopener noreferrer"
              class="grid lg:grid-cols-[1.12fr_0.88fr] rounded-2xl overflow-hidden h-full"
              style="background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.015) 100%);
                     border: 1px solid rgba(255,255,255,0.08);
                     box-shadow: 0 0 0 1px rgba(255,255,255,0.03), 0 20px 60px rgba(0,0,0,0.45);">

              <!-- Browser chrome + live screenshot -->
              <div class="relative flex flex-col overflow-hidden lg:border-r border-white/[0.06]" style="background: #0a0f0c;">
                <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-white/[0.06] flex-shrink-0">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-400/50"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/50"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-accent/50"></span>
                  <span class="ml-3 text-[10px] font-mono text-fg-muted truncate">
                    {p.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                  </span>
                </div>
                <div class="relative aspect-[16/10] lg:aspect-auto lg:flex-1 lg:min-h-0 overflow-hidden">
                  <img
                    src={p.img}
                    alt={`Captura del sitio ${p.name} — ${p.kind}`}
                    width="1440" height="900"
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="shot w-full h-full object-cover object-top"
                  />
                  <div class="absolute inset-0 pointer-events-none"
                    style="background: linear-gradient(180deg, transparent 55%, rgba(3,7,4,0.45) 100%);"></div>
                </div>
              </div>

              <!-- Meta -->
              <div class="p-6 lg:p-8 flex flex-col justify-center">
                <div class="flex items-center gap-3 mb-4 flex-wrap">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider"
                    style={`color: ${p.accent}; border: 1px solid ${p.accent}33; background: ${p.accent}12;`}>
                    {p.kind}
                  </span>
                  <span class="text-[10px] font-mono text-fg-muted">{p.year}</span>
                </div>

                <h3 class="text-2xl lg:text-3xl font-semibold tracking-tight text-fg mb-3">{p.name}</h3>
