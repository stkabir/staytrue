---
import '../styles/global.css';
import { WHATSAPP, EMAIL } from '../data/projects';

// Aviso de privacidad — LFPDPPP (México). El contenido vive en un arreglo
// de secciones: cada una se numera sola y alimenta el índice lateral.
const UPDATED = "Septiembre de 2026";

type Block =
  | { p: string }
  | { list: string[] }
  | { note: string };

type Section = { id: string; title: string; blocks: Block[] };

const sections: Section[] = [
  {
    id: "responsable",
    title: "Responsable de sus datos",
    blocks: [
      { p: `<strong>Stay True Digital Studio</strong> (&ldquo;Stay True&rdquo;), estudio de desarrollo de software con operaciones en Xalapa, Veracruz y Cancún, Quintana Roo, es responsable del tratamiento de los datos personales que usted proporcione a través de nuestros formularios, sitio web, redes sociales y medios de contacto.` },
      { p: `Para cualquier asunto relacionado con este aviso puede escribirnos a <a class="lnk" href="mailto:${EMAIL}">${EMAIL}</a> o por WhatsApp al <a class="lnk" href="${WHATSAPP}" target="_blank" rel="noopener noreferrer">+52 998 116 9584</a>.` },
      { note: "Este aviso se emite conforme a la Ley Federal de Protección de Datos Personales en Posesión de los Particulares (LFPDPPP), su Reglamento y los Lineamientos del Aviso de Privacidad." },
    ],
  },
  {
    id: "datos",
    title: "Datos que podemos recopilar",
    blocks: [
      { p: "Podemos solicitar datos como nombre, teléfono, correo electrónico, empresa y la información relacionada con el servicio o proyecto de su interés." },
      { p: "Cuando usted navega el sitio también podemos registrar datos técnicos de forma agregada: dirección IP, tipo de dispositivo y navegador, páginas visitadas y origen de la visita." },
      { p: "<strong>No recabamos datos personales sensibles</strong> (origen étnico, estado de salud, creencias, preferencias sexuales u opiniones políticas) ni datos financieros o patrimoniales a través de este sitio. Nuestros servicios no están dirigidos a menores de edad." },
    ],
  },
  {
    id: "finalidades",
    title: "Finalidades del tratamiento",
    blocks: [
      { p: "Sus datos se tratan para las siguientes finalidades primarias, necesarias para atenderle:" },
      { list: [
        "Contactarle y atender su solicitud de información.",
        "Brindarle información sobre nuestros servicios.",
        "Elaborar propuestas o cotizaciones.",
        "Dar seguimiento a solicitudes, proyectos o servicios contratados.",
        "Cumplir con obligaciones contractuales, fiscales y legales derivadas de un servicio contratado.",
      ] },
      { p: "De forma adicional, y solo si usted no manifiesta su negativa, podemos usar sus datos para finalidades secundarias:" },
      { list: [
        "Mantener comunicación comercial relacionada con nuestros servicios.",
        "Enviarle novedades, casos de estudio o promociones del estudio.",
      ] },
      { note: `Puede negarse al tratamiento para finalidades secundarias en cualquier momento escribiendo a ${EMAIL}. Su negativa no será motivo para negarle los servicios que solicite.` },
    ],
  },
  {
    id: "uso",
    title: "Uso y protección de la información",
    blocks: [
      { p: "Sus datos serán utilizados únicamente para las finalidades señaladas en este aviso. <strong>No vendemos sus datos personales</strong> ni los compartimos con terceros con fines comerciales ajenos a Stay True, salvo cuando exista una obligación legal o sea necesario para la prestación de un servicio solicitado." },
      { p: "Aplicamos medidas de seguridad administrativas, técnicas y físicas razonables para proteger sus datos contra daño, pérdida, alteración, destrucción o acceso no autorizado: cifrado en tránsito (HTTPS), acceso restringido al personal que necesita la información y respaldos controlados." },
    ],
  },
  {
    id: "transferencias",
    title: "Transferencias y proveedores",
    blocks: [
      { p: "Para operar nos apoyamos en proveedores de servicio que actúan por cuenta nuestra —hosting, correo electrónico, mensajería y herramientas de analítica—, quienes tratan sus datos únicamente bajo nuestras instrucciones y conforme a este aviso. Estas remisiones no requieren su consentimiento." },
      { p: "Solo transferiremos sus datos a terceros sin su consentimiento en los supuestos previstos por el artículo 37 de la LFPDPPP, como el cumplimiento de una obligación legal o el requerimiento de una autoridad competente." },
    ],
  },
  {
    id: "cookies",
    title: "Cookies y tecnologías de rastreo",
    blocks: [
      { p: "El sitio puede usar cookies y tecnologías similares para recordar preferencias y medir el uso de las páginas de forma estadística. Estas herramientas no recaban información que le identifique directamente." },
      { p: "Usted puede deshabilitar o eliminar las cookies desde la configuración de su navegador. Algunas funciones del sitio podrían dejar de comportarse como se espera si lo hace." },
    ],
  },
  {
    id: "conservacion",
    title: "Conservación de los datos",
    blocks: [
      { p: "Conservamos sus datos durante el tiempo necesario para cumplir las finalidades descritas y, después, durante los plazos que exija la legislación aplicable —por ejemplo la normativa fiscal y mercantil—, para luego bloquearlos y suprimirlos." },
    ],
  },
  {
    id: "derechos",
    title: "Derechos sobre sus datos (ARCO)",
    blocks: [
      { p: `Puede solicitar <strong>acceso, rectificación, cancelación u oposición</strong> al tratamiento de sus datos personales, así como pedir dejar de recibir comunicaciones, escribiendo a <a class="lnk" href="mailto:${EMAIL}">${EMAIL}</a>.` },
      { p: "También puede revocar el consentimiento que nos haya otorgado, con la misma solicitud y por el mismo medio." },
      { p: "Para poder atenderle, su solicitud debe incluir:" },
      { list: [
        "Nombre completo y un medio para comunicarle la respuesta.",
        "Documento que acredite su identidad (o la representación legal, en su caso).",
        "Descripción clara de los datos y del derecho que desea ejercer.",
        "Cualquier elemento o documento que facilite localizar sus datos.",
      ] },
      { note: "Responderemos su solicitud en un plazo máximo de 20 días hábiles y, de resultar procedente, la haremos efectiva dentro de los 15 días hábiles siguientes." },
    ],
  },
  {
    id: "cambios",
    title: "Cambios al aviso",
    blocks: [
      { p: "Este aviso de privacidad puede actualizarse cuando sea necesario. Las modificaciones serán publicadas en esta misma página o en nuestro sitio web, indicando la fecha de la última actualización." },
      { p: "Si el cambio es sustancial, se lo haremos saber por el mismo medio de contacto que usted nos haya proporcionado." },
    ],
  },
  {
    id: "autoridad",
    title: "Autoridad competente",
    blocks: [
      { p: "Si considera que su derecho a la protección de datos personales ha sido vulnerado, puede acudir ante la autoridad competente en materia de protección de datos personales en México para presentar la queja o denuncia correspondiente." },
    ],
  },
];

const TITLE = "Aviso de Privacidad — Stay True Digital Studio";
const DESC  = "Aviso de privacidad de Stay True Digital Studio: qué datos recabamos, para qué los usamos, cómo los protegemos y cómo ejercer sus derechos ARCO.";
const URL   = "https://staytruemx.com/aviso-privacidad";
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="mask-icon" href="/favicon-mono.svg" color="#22c55e" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="msapplication-TileColor" content="#030704" />
  <meta name="msapplication-TileImage" content="/apple-touch-icon.png" />
  <meta name="msapplication-config" content="none" />

  <!-- Hide animated elements before first paint so they don't flash in
       and then jump back to their start state once GSAP loads. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.documentElement.classList.add('av-anim');
  </script>
  <style is:inline>
    .av-anim .av-char, .av-anim .av-sub, .av-anim .av-block { opacity: 0; }
    /* Enlaces dentro del texto legal — subrayado discreto en acento. */
    .lnk {
      color: #4ade80;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(74,222,128,0.35);
      transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }
    .lnk:hover { color: #6ee7b7; text-decoration-color: rgba(110,231,183,0.7); }
    /* Índice lateral: la sección visible se marca con el acento. */
    .toc-link.is-active { color: #e8efe9; }
    .toc-link.is-active .toc-dot { background: #22c55e; box-shadow: 0 0 10px rgba(34,197,94,0.7); }
  </style>

  <!-- ── Primary SEO ──────────────────────────────────────────── -->
  <title>{TITLE}</title>
  <meta name="description" content={DESC} />
  <meta name="author" content="Stay True Digital Studio" />
  <meta name="robots" content="index, follow, max-snippet:-1" />
  <link rel="canonical" href={URL} />
  <meta name="theme-color" content="#030704" />

  <!-- ── Open Graph ───────────────────────────────────────────── -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Stay True Digital Studio" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:url" content={URL} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESC} />
  <meta property="og:image" content="https://staytruemx.com/og-image.jpg?v=2" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="Stay True — Aviso de privacidad" />

  <!-- ── Twitter ──────────────────────────────────────────────── -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={DESC} />
  <meta name="twitter:image" content="https://staytruemx.com/og-image.jpg?v=2" />

  <!-- ── Performance ──────────────────────────────────────────── -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" /></noscript>

  <!-- ── Structured data (JSON-LD) ────────────────────────────── -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${URL}#page`,
    "url": URL,
    "name": TITLE,
    "description": DESC,
    "inLanguage": "es-MX",
    "isPartOf": { "@type": "WebSite", "url": "https://staytruemx.com/", "name": "Stay True Digital Studio" },
    "about": { "@id": "https://staytruemx.com/#studio" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://staytruemx.com/" },
        { "@type": "ListItem", "position": 2, "name": "Aviso de privacidad", "item": URL },
      ],
    },
  })} />
</head>

<body class="bg-canvas text-fg font-sans antialiased overflow-x-hidden">

  <div id="scroll-progress" aria-hidden="true"></div>

  <!-- ══════════════════════════════════════
       NAVBAR
  ══════════════════════════════════════ -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/[0.06]">
    <div class="absolute inset-0 bg-canvas/80 backdrop-blur-xl"></div>
    <div class="relative max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3" aria-label="Stay True — inicio">
        <img src="/img/logo.svg" alt="Stay True logo" class="h-8 w-8" width="32" height="32" />
      </a>
      <div class="flex items-center gap-5">
        <a href="/proyectos" class="hidden sm:inline text-sm text-fg-muted hover:text-fg transition-colors duration-200">
          Ver portafolio
        </a>
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 md:px-4 py-2 rounded-lg text-xs md:text-sm font-medium text-canvas bg-accent hover:bg-accent-bright transition-all duration-200 active:scale-[0.97]"
          style="box-shadow: 0 0 0 1px rgba(34,197,94,0.5), 0 4px 16px rgba(34,197,94,0.28), inset 0 1px 0 rgba(255,255,255,0.14);">
          Hablemos
          <svg class="hidden md:block" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <main>

  <!-- ══════════════════════════════════════
       HEADER
  ══════════════════════════════════════ -->
  <header class="relative pt-28 lg:pt-32 pb-10 lg:pb-14 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none flex justify-center" aria-hidden="true">
      <div class="w-[720px] h-[380px] -mt-32 rounded-full"
        style="background: radial-gradient(ellipse, rgba(34,197,94,0.08) 0%, transparent 70%); filter: blur(60px);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6">
      <nav class="av-sub flex items-center gap-2 text-xs text-fg-muted mb-6" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-fg transition-colors">Inicio</a>
        <span class="text-accent/50">/</span>
        <span class="text-fg">Aviso de privacidad</span>
      </nav>
      <!-- overflow-hidden on the h1 masks the letters rising from below -->
      <h1 class="overflow-hidden text-4xl md:text-6xl font-semibold tracking-tight leading-[1.1] pb-1" aria-label="Aviso de Privacidad">
        {'Aviso de Privacidad'.split(' ').map((w, wi) => (
          <>
            {wi > 0 && ' '}
            <span class="inline-block whitespace-nowrap" aria-hidden="true">
              {w.split('').map(c => <span class="av-char inline-block grad-heading">{c}</span>)}
            </span>
          </>
        ))}
      </h1>
      <div class="av-sub mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
        <p class="text-xs font-mono tracking-[0.3em] uppercase text-accent">privacidad</p>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-mono text-fg-muted"
          style="border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03);">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          Última actualización: {UPDATED}
        </span>
      </div>
      <p class="av-sub mt-6 max-w-2xl text-base md:text-lg text-fg-muted leading-relaxed">
        Stay True es responsable del tratamiento de los datos personales que usted proporcione a través de
        nuestros formularios, sitio web, redes sociales y medios de contacto. Aquí explicamos qué recabamos,
        para qué lo usamos y cómo puede controlarlo.
      </p>
    </div>
  </header>

  <!-- ══════════════════════════════════════
       CONTENIDO — índice fijo + secciones
  ══════════════════════════════════════ -->
  <section class="relative pb-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">

        <!-- Índice -->
        <aside class="lg:col-span-4">
          <div class="av-block lg:sticky lg:top-24 card-spotlight rounded-2xl p-6"
            style="background: linear-gradient(135deg, rgba(255,255,255,0.045) 0%, rgba(255,255,255,0.012) 100%);
                   border: 1px solid rgba(255,255,255,0.07);
                   box-shadow: 0 0 0 1px rgba(255,255,255,0.03), 0 4px 24px rgba(0,0,0,0.3);">
            <div class="text-[10px] font-mono text-accent tracking-widest uppercase mb-5">Contenido</div>
            <ul class="space-y-2.5">
              {sections.map((s, i) => (
                <li>
                  <a href={`#${s.id}`} data-toc={s.id}
                    class="toc-link flex items-start gap-3 text-sm text-fg-muted hover:text-fg transition-colors">
                    <span class="toc-dot mt-[7px] w-1.5 h-1.5 rounded-full flex-shrink-0 bg-white/20 transition-all duration-300"></span>
                    <span>
                      <span class="font-mono text-[11px] text-fg-muted/60 mr-1.5">{String(i + 1).padStart(2, '0')}</span>{s.title}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-5 border-t border-white/[0.06]">
              <p class="text-xs text-fg-muted leading-relaxed mb-3">¿Dudas sobre sus datos? Escríbanos.</p>
              <a href={`mailto:${EMAIL}`}
                class="inline-flex items-center gap-1.5 font-mono text-xs text-accent hover:text-accent-bright transition-colors">
                {EMAIL}
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </aside>

        <!-- Secciones -->
        <div class="lg:col-span-8 space-y-4">
          {sections.map((s, i) => (
            <article id={s.id} class="av-block card-spotlight scroll-mt-24 rounded-2xl p-6 md:p-8"
              style="background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
                     border: 1px solid rgba(255,255,255,0.07);
                     box-shadow: 0 0 0 1px rgba(255,255,255,0.03), 0 4px 24px rgba(0,0,0,0.3);">
              <div class="flex items-baseline gap-3 mb-5">
                <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="text-xl md:text-2xl font-semibold tracking-tight text-fg leading-tight">{s.title}</h2>
              </div>
              <div class="space-y-4">
                {s.blocks.map(b => (
                  'p' in b ? (
                    <p class="text-sm md:text-[15px] text-fg-muted leading-relaxed" set:html={b.p} />
                  ) : 'list' in b ? (
                    <ul class="space-y-2.5">
                      {b.list.map(item => (
                        <li class="flex items-start gap-3 text-sm md:text-[15px] text-fg-muted leading-relaxed">
                          <svg class="mt-[5px] flex-shrink-0 text-accent" xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="rounded-xl px-4 py-3 text-xs md:text-sm text-fg-muted/85 leading-relaxed"
                      style="border-left: 2px solid rgba(34,197,94,0.5); background: rgba(34,197,94,0.05);">
                      {b.note}
                    </p>
                  )
                ))}
              </div>
            </article>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CTA
  ══════════════════════════════════════ -->
  <section class="relative py-20 lg:py-24 border-t border-white/[0.06] overflow-hidden">
    <div class="absolute inset-0 pointer-events-none flex items-center justify-center" aria-hidden="true">
      <div class="w-[640px] h-[400px] rounded-full animate-pulse-glow"
        style="background: radial-gradient(ellipse, rgba(34,197,94,0.08) 0%, transparent 70%); filter: blur(60px);"></div>
    </div>
    <div class="av-block relative max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight mb-5">
        <span class="grad-heading">¿Quiere ejercer</span>
        <span class="shimmer-text">sus derechos?</span>
      </h2>
      <p class="text-base md:text-lg text-fg-muted leading-relaxed mb-10 max-w-xl mx-auto">
        Una solicitud de acceso, rectificación, cancelación u oposición se atiende por correo. Respondemos en
        un máximo de 20 días hábiles.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href={`mailto:${EMAIL}?subject=Solicitud%20ARCO`}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg text-sm font-medium text-canvas bg-accent hover:bg-accent-bright transition-all duration-200 active:scale-[0.97]"
          style="box-shadow: 0 0 0 1px rgba(34,197,94,0.5), 0 10px 40px rgba(34,197,94,0.35), inset 0 1px 0 rgba(255,255,255,0.14);">
          Enviar solicitud
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-4 rounded-lg text-sm font-medium text-fg transition-all duration-200 hover:bg-white/[0.05]"
          style="box-shadow: inset 0 0 0 1px rgba(255,255,255,0.09);">
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>

  </main>

  <!-- ══════════════════════════════════════
       FOOTER
  ══════════════════════════════════════ -->
  <footer class="relative border-t border-white/[0.06]" style="background: #010402;">
    <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-fg-muted">
      <p>© {new Date().getFullYear()} Stay True Digital Studio</p>
      <p class="text-center">
        <span class="text-accent">◆</span>&nbsp; Xalapa · Cancún &nbsp;·&nbsp;
        <a href={`mailto:${EMAIL}`} class="hover:text-fg transition-colors">{EMAIL}</a> &nbsp;·&nbsp;
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="hover:text-fg transition-colors">+52 998 116 9584</a>
      </p>
    </div>
  </footer>

</body>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  gsap.defaults({ ease: 'power3.out' });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    // ── Scroll progress bar ──────────────────────────────────
    gsap.to('#scroll-progress', {
      scaleX: 1, ease: 'none',
      scrollTrigger: { start: 'top top', end: 'max', scrub: true },
    });

    // ── Title: letters rise out of the h1's overflow mask ────
    // fromTo, not from: the `av-anim` class already holds them at opacity 0.
    gsap.fromTo('.av-char',
      { yPercent: 110, opacity: 0 },
      { yPercent: 0, opacity: 1, duration: 0.8, stagger: 0.025, clearProps: 'transform' });
    gsap.fromTo('.av-sub',
      { opacity: 0, y: 10 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.08, delay: 0.35 });

    // ── Blocks: fade-up as each card enters ──────────────────
    gsap.utils.toArray<HTMLElement>('.av-block').forEach(block => {
      gsap.fromTo(block,
        { opacity: 0, y: 32 },
        {
          opacity: 1, y: 0, duration: 0.8, clearProps: 'transform',
          scrollTrigger: { trigger: block, start: 'top 90%', once: true },
        });
    });

    window.addEventListener('load', () => ScrollTrigger.refresh());
  }

  // ── Índice: resalta la sección en pantalla ─────────────────
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.toc-link').forEach(a => links.set(a.dataset.toc!, a));

  const spy = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      links.forEach(a => a.classList.remove('is-active'));
      links.get(e.target.id)?.classList.add('is-active');
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });

  // ── Card spotlight (mouse-track radial glow) ───────────────
  document.querySelectorAll<HTMLElement>('.card-spotlight').forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    });
  });
</script>
</html>
